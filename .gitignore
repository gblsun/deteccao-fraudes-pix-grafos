# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Ambientes
.venv/
venv/
.env

# Editores / sistema
# .vscode/: só a configuração compartilhada do projeto (formatador e testes) é versionada
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Dados: são gerados pelos scripts ou baixados da API, então não são versionados.
# Os resultados (reports/) são pequenos e ficam no repositório.
data/**/*
!data/**/
!data/**/.gitkeep
!data/README.md

# Obsidian: versiona só a configuração compartilhada (links, modelos e diário);
# layout das janelas, plugins e aparência ficam só na máquina de cada um.
.obsidian/*
!.obsidian/app.json
!.obsidian/templates.json
!.obsidian/daily-notes.json
!.obsidian/graph.json

# Saída de scripts/reproduzir_tudo.ps1 -Rapido (conferência, não é resultado)
reports_teste/

# Referência da API gerada pelo pdoc (ver src/pixfraud/README.md)
site/

# Relatório gerado pelo Pandoc (pode conter dados pessoais acrescentados à mão)
relatorio/saida/

# Progresso salvo das avaliações longas: recalculável, serve só para retomar
reports/**/online_cortes/
reports/**/*_janelas/
